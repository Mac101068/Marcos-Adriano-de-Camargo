# Ambientes virtuais e cache Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.log
# stderr dos processos que ligamos em background (ponte, dev server): runtime, não código
*.err

# Descartáveis do tipo tmp_* (checagens one-off, prints de tela). O nome já diz que não é obra.
tmp_*

# Cache do IDE (wiki/conhecimento gerado automaticamente, não é código do projeto)
.qoder/

# Node e dependências
node_modules/
interface_github/node_modules/
interface_github/dist/

# Backups e binários
backups/
*.zip
*.csv

# Base de ticks (fitas de segundos): ficam APENAS no disco de quem as coletou.
# Um pregão descompactado passa de 300 MB e o .gz dele custa ~7 MB por dia, então
# o histórico inteiro inchava o repositório sem servir como código. Os recortes
# que o replay precisa já viajam prontos no frontend (interface_github/dados/,
# ~6 MB, com verificação de soma de fluxos), não é preciso duplicá-los aqui.
# Atenção à semântica: '*.csv' nunca casou com 'arquivo.csv.gz' (termina em .gz),
# por isso as fitas entravam no Git mesmo "ignoradas". E não adianta re-incluir
# ('!data/*.gz') depois de excluir o diretório pai: o Git nem desce nele.
data/

# Token local sincronizado entre ponte e interface
bridge_token.txt
interface_github/public/bridge_token.txt


.vscode/
.agents/
interface_github/
